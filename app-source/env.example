# Every environment variable the scheduler engine reads.
# Set these on Vercel (encrypted env), never in the repo.
# A missing capability degrades to a clean no-op — it never crashes the site.

# GOOGLE CALENDAR + GMAIL (REQUIRED for live booking + live email)
# One OAuth client, one refresh token, scoped for BOTH Calendar
# (https://www.googleapis.com/auth/calendar) and Gmail send
# (https://www.googleapis.com/auth/gmail.send) on the account that owns the
# calendar and sends as joseph@hana.events. Absent, every route reports
# configured:false, the widget shows its fallback panel, and emails log to
# the console instead of sending.
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
ATLAS_GOOGLE_REFRESH_TOKEN=

# Comma-separated Google Calendar ids. Busy time is unioned across ALL of
# them; bookings are written to the FIRST. Real values for this instance
# (fill in once the calendars are confirmed, do not hardcode in code):
#   1. joseph@hana.events  (WORK, the write calendar, bookings land here)
#   2. HANA Events  (busy-block only, Atlas never writes here)
#   3. Personal     (busy-block only, Atlas never writes here)
# Defaults to "primary" if unset. Confirmed live 2026-08-28:
BOOKING_CALENDAR_ID=joseph@hana.events,YOUR_BUSY_CALENDAR_ID@group.calendar.google.com,YOUR_BUSY_CALENDAR_ID@group.calendar.google.com

# PODIO HAND-OFF + SELF-SERVICE MANAGE LINKS (REQUIRED for both)
# Signs the hana-booking-signature header on every booking.* webhook to the
# Mac-side Podio ingest, AND signs the confirm/reschedule/cancel links in
# the reminder emails and the booking confirmation's "Manage this meeting"
# line (lib/booking/manage-token.ts). Absent, Podio hand-off silently no-ops
# (podio_notify_failed logged) and every manage link is simply omitted from
# outgoing email -- never a broken link.
BOOKING_WEBHOOK_SECRET=
# Defaults to https://your-crm-webhook.example.com/booking if unset.
BOOKING_WEBHOOK_URL=
# Defaults to https://calendar.hana.events if unset. Only needs setting for
# a preview/staging deploy on a different origin.
NEXT_PUBLIC_BASE_URL=

# REMINDER SWEEP (REQUIRED)
# Bearer token. GET /api/booking/reminders returns 401 without a matching
# Authorization header. Vercel's own cron (see vercel.json) sends
# `Authorization: Bearer $CRON_SECRET` automatically whenever this is set.
CRON_SECRET=

# ZOOM (OPTIONAL; ALL THREE OR NONE)
# Server-to-Server OAuth app on the account that hosts Joseph's Zoom
# meetings. Absent, a Zoom-location booking still succeeds — the invitee
# email says the join link will follow separately, and the operator email
# flags "Zoom unconfigured".
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Dormant flag. Default off — this build's video platform is Zoom, not
# Google Meet. The Meet path in lib/booking/google.ts only activates if this
# is set to "1", for a future instance that wants Meet instead of Zoom.
BOOKING_GOOGLE_MEET_ENABLED=

# TWILIO (OPTIONAL; ALL THREE OR NONE)
# Absent, the system is email-only (the actual launch state) and every text
# send is a silent no-op — never an error, never logged as a failure.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# NOTIFICATIONS
# Where the "new booking" operator email goes, and the invitee's reply-to
# on the day-of text template context.
CONTACT_TO=joseph@hana.events

# SATELLITE BRAND SURFACES (OPTIONAL, not used at launch)
# Exact origins allowed to call /api/booking/slots and /api/booking/book
# cross-origin. Comma separated, scheme + host + optional port, no trailing
# slash, no wildcard. The scheduler's own pages need none of this — it only
# matters the day a second front end on another domain calls the API
# directly instead of linking/iframing calendar.hana.events.
BOOKING_CORS_ORIGINS=

# LOCAL DEVELOPMENT ONLY
# No external calls, empty busy list, fake calendar events, emails/texts
# logged to the console instead of sent. Never set this in production.
BOOKING_MOCK=1

# DORMANT — NOT USED IN THIS BUILD
# lib/booking/resend.ts is a dormant fallback email path (Resend instead of
# Gmail). Nothing calls it. Set these only if that file is ever activated.
RESEND_API_KEY=
BOOKING_FROM=
